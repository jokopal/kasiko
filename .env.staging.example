# Copy to .env.staging (git-ignored). STAGING project only — never production values.
# Public values the staging build uses:
VITE_SUPABASE_URL=https://<staging-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Refuses to run if VITE_SUPABASE_URL contains this (the production project ref):
PRODUCTION_REF_GUARD=vvpaptrtwjnsstisdlgy
# E2E owner on staging (create once with scripts/bootstrap-owner.ts against staging):
E2E_OWNER_EMAIL=e2e-owner@kasiko.test
E2E_OWNER_PASSWORD=
# For migrations/tests on staging (session pooler URL):
STAGING_DB_URL=
STAGING_DB_PASSWORD=
